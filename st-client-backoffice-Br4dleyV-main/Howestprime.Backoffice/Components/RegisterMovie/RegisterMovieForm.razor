@using Howestprime.Backoffice.ViewModels.RegisterMovie

<EditForm Model="Model" OnValidSubmit="OnSubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-summary" />

    <div class="form-group">
        <label for="title">Title</label>
        <InputText id="title" class="form-control" @bind-Value="Model.Title" />
        <ValidationMessage For="() => Model.Title" />
    </div>

    <div class="form-group">
        <label for="genres">Genre(s)</label>
        <InputText id="genres" class="form-control" @bind-Value="Model.Genres" />
        <ValidationMessage For="() => Model.Genres" />
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <InputTextArea id="description" class="form-control" rows="4" @bind-Value="Model.Description" />
        <ValidationMessage For="() => Model.Description" />
    </div>

    <div class="form-group">
        <label for="releaseYear">Release Year</label>
        <InputNumber id="releaseYear" class="form-control" @bind-Value="Model.ReleaseYear" />
        <ValidationMessage For="() => Model.ReleaseYear" />
    </div>

    <div class="form-group">
        <label for="duration">Duration (minutes)</label>
        <InputNumber id="duration" class="form-control" @bind-Value="Model.Duration" />
        <ValidationMessage For="() => Model.Duration" />
    </div>

    <div class="form-group">
        <label for="actors">Actors</label>
        <InputText id="actors" class="form-control" @bind-Value="Model.Actors" />
        <ValidationMessage For="() => Model.Actors" />
    </div>

    <div class="form-group">
        <label for="ageRating">Age Rating</label>
        <InputNumber id="ageRating" class="form-control" @bind-Value="Model.AgeRating" />
        <ValidationMessage For="() => Model.AgeRating" />
    </div>

    <div class="form-group">
        <label for="posterUrl">Poster URL</label>
        <input id="posterUrl" class="form-control" value="@Model.PosterUrl" @oninput="HandlePosterUrlInput" />
        <ValidationMessage For="() => Model.PosterUrl" />
    </div>

    <div class="button-group">
        <button type="submit" class="submit-button" disabled="@IsSubmitting">REGISTER MOVIE</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public required RegisterMovieViewModel Model { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback<string> PosterUrlChanged { get; set; }

    private Task OnSubmitAsync() => OnSubmit.InvokeAsync();

    private async Task HandlePosterUrlInput(ChangeEventArgs e)
    {
        var posterUrl = e.Value?.ToString() ?? string.Empty;
        Model.PosterUrl = posterUrl;
        await PosterUrlChanged.InvokeAsync(posterUrl);
    }
}
